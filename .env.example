# Supabase Postgres connection string - REQUIRED in production.
# Use the pooler URL (transaction mode, port 6543) for serverless; see
# docs/specs/2026-10-24-recalllab-design.md section 6.4.
# If this is unset, the server falls back to an in-memory Postgres (pg-mem),
# which is a DEVELOPMENT convenience only.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Secret that authenticates Vercel cron calls to GET /api/health.
# Vercel sends it as: Authorization: Bearer <CRON_SECRET>
# If unset, /api/health accepts unauthenticated requests (development only).
CRON_SECRET=

# Port used by the local server.
PORT=3000
